# --- Supabase (fra `supabase start` lokalt, eller prosjektinnstillinger i Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kun server. Brukes av synkronisering og sikker dokumentlagring. ALDRI eksponer i klienten.
SUPABASE_SERVICE_ROLE_KEY=

# 32 byte nøkkel, base64. Lag med:  openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=

# --- Integrasjoner (la stå tomme til skolen har fått tilgang) ---
# Microsoft 365 Education (Graph): app-registrering i skolens Entra ID
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Canvas
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
# itslearning / iSkole: krever partneravtale med leverandør
ITSLEARNING_CLIENT_ID=
ITSLEARNING_CLIENT_SECRET=
ISKOLE_CLIENT_ID=
ISKOLE_CLIENT_SECRET=

# --- Personlige tilkoblinger (elevens egne kontoer, OAuth 2.0) ---
# Full adresse til appen; brukes i redirect-URI-er: <APP_URL>/api/connect/<tjeneste>/callback
APP_URL=http://localhost:3000
# 32 byte, base64. Krypterer lagrede OAuth-tokens.  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Canvas: Developer Key fra skolens Canvas-administrator (CANVAS_BASE_URL står over)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Valgfritt: egne scopes (mellomromsdelt) eller "none" hvis nøkkelen ikke håndhever scopes
CANVAS_SCOPES=
# Microsoft: bruker MS_CLIENT_ID / MS_CLIENT_SECRET / MS_TENANT_ID over. Redirect-URI må registreres i app-registreringen.
# true = be om EduAssignments.Read (karakterer) i stedet for EduAssignments.ReadBasic
MS_INCLUDE_GRADES=false

# --- AI-assistent (valgfritt). Uten nøkkel brukes bare regelbaserte svar. ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# --- Direkte lenker ---
# Offisiell adresse til skolens iSkole-portal (brukes bare som «Åpne iSkole» når ingen direkte lenke finnes)
ISKOLE_PORTAL_URL=
ITSLEARNING_PORTAL_URL=
# Maks antall Teams-oppgaver det hentes dyplenke for per synkronisering
MS_LINK_LOOKUPS=80
